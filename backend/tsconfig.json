{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    /* We run everything through tsx and never emit, so importing a `.ts`
       extension directly is allowed. This is what lets the backend import the
       shared contract by relative path without an npm workspace. */
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "drizzle.config.ts", "../shared/**/*.ts"],
  "exclude": ["node_modules", "../shared/cost.test.ts"]
}
