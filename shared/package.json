{
  "name": "@dezine/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared domain contract and cost engine for the 3xDezine backend, web and Android clients.",
  "exports": {
    "./types": "./types.ts",
    "./cost": "./cost.ts",
    "./catalog.seed.json": "./catalog.seed.json",
    "./sample-project.json": "./sample-project.json",
    "./rules": "./rules.ts",
    "./business": "./business.ts",
    "./money": "./money.ts",
    "./gst": "./gst.ts",
    "./trades": "./trades.ts",
    "./modular": "./modular.ts",
    "./quote": "./quote.ts",
    "./plans": "./plans.ts",
    "./ratecards/*.json": "./ratecards/*.json",
    "./templates/index.json": "./templates/index.json",
    "./templates/*.json": "./templates/*.json"
  },
  "scripts": {
    "test": "tsx --test cost.test.ts rules.test.ts templates.test.ts money.test.ts gst.test.ts trades.test.ts modular.test.ts quote.test.ts plans.test.ts",
    "typecheck": "tsc --noEmit",
    "templates": "tsx templates/generate.ts"
  }
}
