# Edge Function secrets for LOCAL development. Copy to supabase/functions/.env
# (gitignored). In production set these with `npx supabase secrets set`, never
# BILLING_SIMULATION. See docs/billing.md.

# Local only: simulate Razorpay checkout. Ignored when any RAZORPAY_KEY_* is
# set or when the functions don't run against the local stack.
BILLING_SIMULATION=1

# Webhook signing secret (any string locally; the e2e test signs with it).
RAZORPAY_WEBHOOK_SECRET=local-webhook-secret

# Razorpay test keys (rzp_test_...) — leave empty to keep simulation on.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_PLAN_SOLO_MONTH=plan_...
# RAZORPAY_PLAN_SOLO_YEAR=plan_...
# RAZORPAY_PLAN_STUDIO_MONTH=plan_...
# RAZORPAY_PLAN_STUDIO_YEAR=plan_...
